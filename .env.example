# Rhoddo admin (Next.js) — environment variables
# Copy to `.env.local` and fill in.

# Base URL of the Rhoddo backend API.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Same value as WEB_PROXY_KEY on the API, so it counts rate limits per visitor.
# Server only: never prefix with NEXT_PUBLIC_.
WEB_PROXY_KEY=""
